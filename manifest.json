{
    "manifest_version": 3,
    "name": "Attendance Eshtu?",
    "version": "3.0",
    "description": "Always show attendance with and without claims on KnowledgePro.",

	"icons": {
		"16": "images/icon.png",
		"32": "images/icon.png",
		"64": "images/icon.png",
		"128": "images/icon.png"
	},

	"browser_specific_settings": {
		"gecko": {
			"id": "@attendance-eshtu",
			"data_collection_permissions": {
				"required": [ "none" ]
			}
		}
	},

	"action": {
		"default_popup": "popup/popup.html"
	},

	"background": {
		"scripts": [ "background.js" ],
		"service_worker": "background.js"
	},

    
    "content_scripts": [
		{
			"matches": ["https://sophoscucentral.christuniversity.in/httpclient.html"],
			"js": ["captivePortal/captivePortal.js"],
			"css": ["captivePortal/captivePortal.css"],
			"run_at": "document_end"
		}, {
			"matches": [ "https://kp.christuniversity.in/KnowledgePro/*" ],
			"js": [
				"login/login.js",
				"lib/tesseract.min.js"
			],
			"css": [
				"login/login.css",
				"fixes.css"
			],
			"run_at": "document_end"
		}, {
			"matches": [ "https://studentespro.christuniversity.in/auth/*" ],
			"js": [ "espro_login/espro_login.js" ],
			"css": [ "espro_login/espro_login.css" ],
			"run_at": "document_end"
		}
    ],

	"host_permissions": [
		"https://cue.christuniversity.in/main/*"
	],
    
    "permissions": [
      	"storage",
		"webNavigation",
		"scripting"
    ]
}